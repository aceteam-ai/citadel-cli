{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Citadel",
  "version": "0.1.0",
  "identifier": "ai.aceteam.citadel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Citadel", "width": 1040, "height": 720, "minWidth": 760, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420; img-src 'self' data:",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/citadel"]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["citadel"] } }
  }
}
