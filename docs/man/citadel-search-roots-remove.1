.TH "CITADEL" "1" "Aug 2026" "AceTeam" "Citadel CLI Manual"

.SH NAME
citadel-search-roots-remove - De-authorize a root directory


.SH SYNOPSIS
\fBcitadel search roots remove  [flags]\fP


.SH DESCRIPTION
De-authorize a root directory


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for remove


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug output

.PP
\fB--model\fP=""
	Embedding model override (default: gte-multilingual-base)

.PP
\fB--no-auto-update\fP[=false]
	Disable automatic update checks and installs for this run (or set CITADEL_NO_AUTO_UPDATE=1)

.PP
\fB--no-color\fP[=false]
	Disable colorized output

.PP
\fB--runtime\fP=""
	Container runtime for module containers: docker or podman (default: auto-detect)


.SH SEE ALSO
\fBcitadel-search-roots(1)\fP
