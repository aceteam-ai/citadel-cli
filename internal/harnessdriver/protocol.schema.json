{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/harness-driver/1",
  "title": "Candidate offline harness-driver/1 contract",
  "oneOf": [{"$ref": "#/$defs/event"}, {"$ref": "#/$defs/command"}],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "maybeId": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/id"}]},
    "model": {"type": "string", "maxLength": 128, "pattern": "^([A-Za-z0-9][A-Za-z0-9._/-]*)?$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nullableCount": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]},
    "text": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "maxLength": 32768}}},
    "empty": {"type": "object", "additionalProperties": false},
    "start": {
      "type": "object", "additionalProperties": false, "required": ["workspace", "model"],
      "properties": {"workspace": {"type": "string", "minLength": 1, "maxLength": 4096}, "model": {"allOf": [{"$ref": "#/$defs/model"}, {"minLength": 1}]}}
    },
    "respond": {
      "type": "object", "additionalProperties": false, "required": ["approval_id", "decision"],
      "properties": {"approval_id": {"$ref": "#/$defs/id"}, "decision": {"enum": ["accept", "decline", "cancel"]}}
    },
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["id", "state", "exit_code", "is_error", "input_preview", "output_excerpt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "state": {"enum": ["started", "completed", "failed"]},
        "exit_code": {"type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647},
        "is_error": {"type": ["boolean", "null"]},
        "input_preview": {"type": "string", "maxLength": 1024}, "output_excerpt": {"type": "string", "maxLength": 1024}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "choices"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["command", "file_change"]},
        "choices": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["accept", "decline", "cancel"]}}
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false, "required": ["id", "decision"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "decision": {"enum": ["accept", "decline", "cancel"]}}
    },
    "usage": {
      "type": "object", "additionalProperties": false, "required": ["model", "input_tokens", "output_tokens", "cached_tokens"],
      "properties": {"model": {"$ref": "#/$defs/model"}, "input_tokens": {"$ref": "#/$defs/nullableCount"}, "output_tokens": {"$ref": "#/$defs/nullableCount"}, "cached_tokens": {"$ref": "#/$defs/nullableCount"}}
    },
    "quota": {
      "type": "object", "additionalProperties": false, "required": ["window", "used_percent", "resets_at"],
      "properties": {
        "window": {"enum": ["unknown", "five_hour", "seven_day"]},
        "used_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "resets_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "models": {
      "type": "object", "additionalProperties": false, "required": ["ids"],
      "properties": {"ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"allOf": [{"$ref": "#/$defs/model"}, {"minLength": 1}]}}}
    },
    "completed": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "tool_errors", "denials"],
      "properties": {"outcome": {"enum": ["completed", "interrupted", "failed", "unknown"]}, "tool_errors": {"$ref": "#/$defs/count"}, "denials": {"$ref": "#/$defs/count"}}
    },
    "failure": {
      "type": "object", "additionalProperties": false, "required": ["code", "retryable"],
      "properties": {"code": {"enum": ["protocol_error", "io_error", "unsupported", "cancelled", "native_error"]}, "retryable": {"type": "boolean"}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "type", "session_name", "incarnation", "native_id", "turn_id", "seq", "ts", "source", "fidelity", "data"],
      "properties": {
        "protocol": {"const": "harness-driver/1"},
        "type": {"enum": ["assistant.text", "assistant.delta", "tool.activity", "approval.requested", "approval.resolved", "usage.reported", "quota.reported", "models.reported", "turn.completed", "session.error"]},
        "session_name": {"$ref": "#/$defs/id"}, "incarnation": {"$ref": "#/$defs/id"},
        "native_id": {"$ref": "#/$defs/maybeId"}, "turn_id": {"$ref": "#/$defs/maybeId"},
        "seq": {"allOf": [{"$ref": "#/$defs/count"}, {"minimum": 1}]},
        "ts": {"type": "string", "format": "date-time"},
        "source": {"enum": ["native", "driver"]}, "fidelity": {"enum": ["structured", "derived"]}, "data": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["assistant.text", "assistant.delta"]}}}, "then": {"properties": {"data": {"$ref": "#/$defs/text"}}}},
        {"if": {"properties": {"type": {"const": "tool.activity"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/tool"}}}},
        {"if": {"properties": {"type": {"const": "approval.requested"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/approval"}}}},
        {"if": {"properties": {"type": {"const": "approval.resolved"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/resolution"}}}},
        {"if": {"properties": {"type": {"const": "usage.reported"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/usage"}}}},
        {"if": {"properties": {"type": {"const": "quota.reported"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/quota"}}}},
        {"if": {"properties": {"type": {"const": "models.reported"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/models"}}}},
        {"if": {"properties": {"type": {"const": "turn.completed"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/completed"}}}},
        {"if": {"properties": {"type": {"const": "session.error"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/failure"}}}}
      ]
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "type", "session_name", "incarnation", "native_id", "turn_id", "request_id", "data"],
      "properties": {
        "protocol": {"const": "harness-driver/1"},
        "type": {"enum": ["session.start", "turn.submit", "approval.respond", "turn.interrupt", "session.stop", "session.probe"]},
        "session_name": {"$ref": "#/$defs/id"}, "incarnation": {"$ref": "#/$defs/id"}, "native_id": {"$ref": "#/$defs/maybeId"},
        "turn_id": {"$ref": "#/$defs/maybeId"}, "request_id": {"$ref": "#/$defs/id"}, "data": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "session.start"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/start"}}}},
        {"if": {"properties": {"type": {"const": "turn.submit"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/text"}}}},
        {"if": {"properties": {"type": {"const": "approval.respond"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/respond"}}}},
        {"if": {"properties": {"type": {"enum": ["turn.interrupt", "session.stop", "session.probe"]}}}, "then": {"properties": {"data": {"$ref": "#/$defs/empty"}}}}
      ]
    }
  }
}
